        t0 = p.t0
        t_ls = _t_of_redshift(p, z_ls, checks.root_xtol_fraction)
        z_check = abs(float(bg.redshift(t_ls, p)) - z_ls) / z_ls
        fv0 = p.fv0
        f_vls = float(bg.fv(t_ls, p))
